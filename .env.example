# Create a Telegram bot with @BotFather, then paste its token here.
TELEGRAM_BOT_TOKEN=
# Numeric Telegram account ID(s), comma separated. Find yours via @userinfobot.
TELEGRAM_ALLOWED_USER_IDS=

# Select: openai, anthropic, google, google-vertex, groq, deepseek,
# openrouter, ollama, azure-openai, mistral, cohere, bedrock, cerebras,
# fireworks, together, openai-compatible, or browser-use.
AI_PROVIDER=openai
AI_MODEL=openai:gpt-4.1
OPENAI_API_KEY=

# Optional: provide keys for the selected provider. Pydantic AI uses its
# standard environment variables (ANTHROPIC_API_KEY, GOOGLE_API_KEY, etc.).
# For OpenAI compatible endpoints:
# AI_PROVIDER=openai-compatible
# AI_MODEL=your-model-name
# AI_BASE_URL=http://127.0.0.1:11434/v1
# AI_API_KEY=local

# Browser Use gateway provider:
# AI_PROVIDER=browser-use
# BROWSER_USE_API_KEY=bu_...

BROWSER_PROFILE=./data/chrome-profile
MAX_STEPS=30
TASK_TIMEOUT_SECONDS=1800
LOG_LEVEL=INFO
